# WiFi and MQTT configuration
# Copy this file to your ESP32 as secrets.py and fill in your values

WIFI_SSID     = "your_wifi_ssid"
WIFI_PASSWORD = "your_wifi_password"

MQTT_BROKER   = "192.168.1.100"   # Your Home Assistant VM's IP address
MQTT_PORT     = 1883
MQTT_USER     = "mqtt_esp32"      # Username from deploy-mqtt.sh --mqtt-user
MQTT_PASSWORD = "your_password"   # Password from deploy-mqtt.sh --mqtt-password
MQTT_CLIENT_ID = "esp32_flow_sensor"
